{
  "schemaVersion": 1,
  "id": "io.github.rafaelvzago.rss",
  "name": "RSS",
  "version": "0.1.0",
  "author": "Rafael Vzago",
  "license": "MIT",
  "description": "Recent posts from RSS 2.0 feeds, with an unread count on the Omarchy bar.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "RSS",
    "description": "Recent posts from RSS 2.0 feeds, with an unread count on the Omarchy bar.",
    "category": "News",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "feedUrls": "",
      "recentListSize": 20,
      "maxItemsPerFeed": 10,
      "itemsPerPage": 10,
      "pollIntervalMinutes": 15,
      "barSection": "right"
    },
    "schema": [
      {
        "key": "feedUrls",
        "type": "string",
        "label": "Feed URLs (one per line)",
        "defaultValue": ""
      },
      {
        "key": "recentListSize",
        "type": "integer",
        "label": "Recent list size",
        "min": 1,
        "max": 100,
        "step": 1,
        "defaultValue": 20
      },
      {
        "key": "maxItemsPerFeed",
        "type": "integer",
        "label": "Max items per feed",
        "min": 1,
        "max": 100,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "pollIntervalMinutes",
        "type": "integer",
        "label": "Poll interval (minutes)",
        "min": 5,
        "max": 1440,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "itemsPerPage",
        "type": "integer",
        "label": "Items per page",
        "min": 1,
        "max": 100,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "barSection",
        "type": "enum",
        "label": "Bar position",
        "options": ["left", "center", "right"],
        "defaultValue": "right"
      }
    ]
  }
}
